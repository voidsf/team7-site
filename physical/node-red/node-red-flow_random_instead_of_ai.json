    {
        "id": "a951750ad7460995",
        "type": "function",
        "z": "0ecc6dbed99f7f08",
        "name": "WaitForMovementStop",
        "func": "// This function waits until motion has stopped for 1.5 seconds before sending a message.\n// It resets the timer each time motion is detected, ensuring only one message is sent after motion ends.\n\n// When motion is detected, restart the timer\nlet timeout = context.get(\"timeout\");\n\nif (timeout) {\n    clearTimeout(timeout);\n}\n\ntimeout = setTimeout(() => {\n    // Trigger the next node after 0.5s of no motion\n    node.send({ payload: \"no motion - go ahead\" });\n}, 1500);\n\ncontext.set(\"timeout\", timeout);\n\n// Don't send anything immediately\nreturn null;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 140,
        "y": 200,
        "wires": [
            [
                "0576bc58635b01b1"
            ]
        ]
    },
