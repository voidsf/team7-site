    {
        "id": "220c7f29c4a945a6",
        "type": "function",
        "z": "0ecc6dbed99f7f08",
        "name": "ParsePayload",
        "func": "// This function extracts the last occurrence of the word \"True\" or \"False\" from the incoming text payload.\n\n// Get the text from the incoming message\nconst text = msg.payload;\n\n// Find all whole-word matches of \"True\" or \"False\" (case-sensitive)\nconst matches = text.match(/\\b(True|False)\\b/g);\n\n// Set the payload to the last match found, or null if none found\nmsg.payload = matches ? matches[matches.length - 1] : null;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
