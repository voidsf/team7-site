        "type": "function",
        "z": "c83e93637860fa4a",
        "name": "Unlock",
        "func": "// Unlock the system by setting 'systemLocked' back to false in the flow context.\nflow.set('systemLocked', false);\n\n// Continue passing the message to the next node (optional, if needed).\nreturn msg;\n",
